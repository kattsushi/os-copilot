{
  "name": "@os-copilot/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node dist/server/server.js",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run",
    "deploy": "alchemy deploy alchemy.run.ts",
    "destroy": "alchemy destroy alchemy.run.ts",
    "cf-dev": "set -a; [ ! -f .env ] || . ./.env; set +a; alchemy dev alchemy.run.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@os-copilot/ui": "workspace:*",
    "@tanstack/solid-router": "catalog:",
    "@tanstack/solid-router-devtools": "catalog:",
    "@tanstack/solid-start": "catalog:",
    "alchemy": "catalog:",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  }
}
