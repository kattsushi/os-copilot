{
  "name": "os-copilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nx dev web",
    "build": "nx build web",
    "preview": "nx preview web",
    "start": "nx start web",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lint": "pnpm run check",
    "lint:fix": "pnpm run fix",
    "lint:affected": "nx affected --target=lint",
    "lint-staged": "lint-staged --allow-empty",
    "typecheck": "nx typecheck web",
    "build:affected": "nx affected --target=build",
    "test:affected": "nx affected --target=test",
    "typecheck:affected": "nx affected --target=typecheck",
    "tsgo:patch": "effect-tsgo patch",
    "prepare": "husky && effect-tsgo patch",
    "nx": "nx"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@nx/js": "catalog:",
    "@nx/storybook": "catalog:",
    "@nx/vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect-qb": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "nx": "catalog:",
    "nx-oxlint": "catalog:",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "typescript": "catalog:",
    "ultracite": "7.7.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,scss}": [
      "pnpm exec ultracite fix"
    ]
  },
  "packageManager": "pnpm@10.32.1"
}
